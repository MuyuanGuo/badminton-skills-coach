{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MuyuanGuo/badminton-skills-coach/schemas/v3/candidate-transcript.schema.json",
  "title": "Badminton Skills Coach v3 transcript candidate",
  "type": "object",
  "required": [
    "schema_version",
    "candidate_id",
    "candidate_fingerprint",
    "source",
    "media",
    "raw_asr",
    "candidate",
    "evidence_status"
  ],
  "properties": {
    "schema_version": {"const": "3.0.0-m1"},
    "candidate_id": {"type": "string", "pattern": "^candidate_[0-9a-f]{24}$"},
    "candidate_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_status": {"const": "candidate_only"},
    "source": {
      "type": "object",
      "required": ["source_id", "platform", "canonical_url", "alternate_urls", "title"]
    },
    "media": {
      "type": "object",
      "required": ["sha256", "duration_ms"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "duration_ms": {"type": "integer", "minimum": 0}
      }
    },
    "raw_asr": {"type": "object", "required": ["sha256", "recipe", "segments"]},
    "candidate": {"type": "object", "required": ["source_id", "segments", "rule_version"]}
  },
  "additionalProperties": false
}

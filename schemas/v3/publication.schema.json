{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MuyuanGuo/badminton-skills-coach/schemas/v3/publication.schema.json",
  "title": "Badminton Skills Coach v3 sanitized shadow publication",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "scope",
    "sources",
    "teaching_events",
    "semantic_claims",
    "review_provenance",
    "privacy_contract",
    "publication_id",
    "publication_fingerprint"
  ],
  "properties": {
    "schema_version": {"const": "3.0.0-m1"},
    "kind": {"const": "v3-shadow-publication"},
    "publication_id": {"type": "string", "pattern": "^publication_[0-9a-f]{24}$"},
    "publication_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sources": {"type": "array"},
    "teaching_events": {"type": "array"},
    "semantic_claims": {"type": "array"},
    "privacy_contract": {
      "type": "object",
      "properties": {
        "full_transcripts_included": {"const": false},
        "raw_asr_included": {"const": false},
        "reviewer_identities_included": {"const": false},
        "sealed_evaluations_included": {"const": false}
      }
    }
  },
  "additionalProperties": false
}

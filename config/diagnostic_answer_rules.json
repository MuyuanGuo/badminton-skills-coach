{
  "version": 23,
  "description": "Deterministic rules for separating reported symptoms, user hypotheses, source-supported diagnostic branches, optional text clarification, and claim-level evidence.",
  "hypothesis_evidence_negation_patterns": [
    "(?:不是|并非|不在于|不靠|不是说靠).{0,10}(?:拍面|握拍|站位|动作|引拍|转体|跨步|启动).{0,4}(?:问题|原因)?"
  ],
  "hypothesis_patterns": [
    {
      "type": "single_cause_question",
      "pattern": "是不是(?P<hypothesis>[^，,。？?！!]+)"
    },
    {
      "type": "alternative_cause_question",
      "pattern": "是(?P<left>[^。？?！!]+?)(?:，|,)?还是(?P<right>[^，,。？?！!]+?)(?:问题|的原因|导致的)?(?:[。？?！!]|$)"
    },
    {
      "type": "alternative_cause_question",
      "pattern": "(?:主要|优先)?(?:看|查|检查|排查)(?P<left>[^。？?！!]+?)(?:，|,)?还是(?P<right>[^，,。？?！!]+?)(?:[？?！!]|$)"
    },
    {
      "type": "alternative_cause_statement",
      "pattern": "(?:我)?(?:怀疑|猜测|猜|觉得|认为)(?:是)?(?P<left>[^，,。；;？?！!]+?)(?:，|,)?(?:也)?(?:可能|或许)(?:是)?(?P<right>[^，,。；;？?！!]+)"
    },
    {
      "type": "possible_alternative_statement",
      "pattern": "(?:我)?(?:怀疑|猜测|觉得|认为)?(?:可能|或许)(?:是)?(?P<left>[^，,。；;？?！!]+?)(?:或|或者)(?P<right>[^，,。；;？?！!]+)"
    },
    {
      "type": "enumerated_cause_request",
      "pattern": "(?:区分|排查|判断|检查)(?P<hypothesis_list>[^。？?！!]+?)(?:问题|原因)(?=[，,。？?！!]|$)"
    }
  ],
  "invalid_hypothesis_patterns": [
    "^(?:这|那|上述|前述).*(?:假设|原因)$",
    "^其他(?:有证据支持)?(?:的原因)?$",
    "^(?:两|2|二|三|3|几)(?:种|个)$"
  ],
  "comparison_signals": ["还是", "一样", "相同", "不同", "区别", "对比", "分别"],

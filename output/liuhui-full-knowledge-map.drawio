<mxfile host="app.diagrams.net" modified="2026-07-10T00:00:00.000Z" agent="Codex" version="24.7.17"><diagram id="liuhui-full" name="全量教学知识图谱"><mxGraphModel dx="2400" dy="2600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3200" pageHeight="2600" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="skill" value="刘辉羽毛球 Skill&lt;br&gt;&lt;b&gt;958 条教学证据&lt;/b&gt;&lt;br&gt;11 个主题大类 · 958 条已入主题索引" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#123B36;fontColor=#FFFFFF;strokeColor=#0C2B27;strokeWidth=3;fontSize=18;fontStyle=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1360" y="80" width="440" height="120" as="geometry" /></mxCell><mxCell id="category-0" value="&lt;b&gt;后场技术&lt;/b&gt;&lt;br&gt;424 条 · 后场击球、被动处理、杀吊突击与架拍框架。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEFEA;strokeColor=#176B5B;strokeWidth=2;fontSize=15;fontStyle=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="60" y="320" width="620" height="86" as="geometry" /></mxCell><mxCell id="edge-1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7A8A86;strokeWidth=2;" edge="1" parent="1" source="skill" target="category-0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="subtopic-0-0" value="&lt;b&gt;被动后场与高远&lt;/b&gt;&lt;br&gt;132 条 · 关键词：被动后场、反手高远、后高点、摆脱" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB8B4;strokeWidth=1.5;fontSize=12;align=left;spacingLeft=10;arcSize=5;" vertex="1" parent="1"><mxGeometry x="60" y="455" width="300" height="82" as="geometry" /></mxCell><mxCell id="edge-2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7A8A86;strokeWidth=2;" edge="1" parent="1" source="category-0" target="subtopic-0-0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="video-0-0-0" value="让反手高远爆炸的秘诀！正确的反手框架加上神仙操作！学员想学反手杀！先把反手高远打透&lt;br&gt;&lt;font color='#52625E'&gt;medium · score 54&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9FBFA;strokeColor=#CBD6D2;strokeWidth=1;fontSize=11;align=left;spacingLeft=8;arcSize=5;" vertex="1" parent="1" link="https://www.bilibili.com/video/BV1ZbcUzDEd6/"><mxGeometry x="390" y="451" width="290" height="68" as="geometry" /></mxCell><mxCell id="edge-3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7A8A86;strokeWidth=2;" edge="1" parent="1" source="subtopic-0-0" target="video-0-0-0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="video-0-0-1" value="反手高远球从1到2进阶教学！业余羽毛球高手发力进阶细节纠错提升！反动反手高远才是实战中需要的&lt;br&gt;&lt;font color='#52625E'&gt;medium · score 44&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9FBFA;strokeColor=#CBD6D2;strokeWidth=1;fontSize=11;align=left;spacingLeft=8;arcSize=5;" vertex="1" parent="1" link="https://www.bilibili.com/video/BV1Ra7BzoEpM/"><mxGeometry x="390" y="529" width="290" height="68" as="geometry" /></mxCell><mxCell id="edge-4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7A8A86;strokeWidth=2;" edge="1" parent="1" source="subtopic-0-0" target="video-0-0-1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="subtopic-0-1" value="&lt;b&gt;杀球与突击&lt;/b&gt;&lt;br&gt;167 条 · 关键词：杀球、重杀、点杀、突击" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB8B4;strokeWidth=1.5;fontSize=12;align=left;spacingLeft=10;arcSize=5;" vertex="1" parent="1"><mxGeometry x="60" y="620" width="300" height="82" as="geometry" /></mxCell><mxCell id="edge-5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7A8A86;strokeWidth=2;" edge="1" parent="1" source="category-0" target="subtopic-0-1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="video-0-1-0" value="杀球杀不好可能是因为你没搞懂什么是杀球？ 正确的杀球概念 看懂后再去试试杀球 猛一倍不止&lt;br&gt;&lt;font color='#52625E'&gt;medium · score 59&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9FBFA;strokeColor=#CBD6D2;strokeWidth=1;fontSize=11;align=left;spacingLeft=8;arcSize=5;" vertex="1" parent="1" link="https://www.bilibili.com/video/BV1Dh4y1h7vW/"><mxGeometry x="390" y="616" width="290" height="68" as="geometry" /></mxCell><mxCell id="edge-6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7A8A86;strokeWidth=2;" edge="1" parent="1" source="subtopic-0-1" target="video-0-1-0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="video-0-1-1" value="杀球瞄准 杀球瞄准 卢迦彧的杀球不是那种很重的，所以落点上就尤为重要，比赛中非常容易被防守反击!中间涉及到…&lt;br&gt;&lt;font color='#52625E'&gt;curated · score 42&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9FBFA;strokeColor=#CBD6D2;strokeWidth=1;fontSize=11;align=left;spacingLeft=8;arcSize=5;" vertex="1" parent="1" link="https://www.douyin.com/video/7659348110628345210"><mxGeometry x="390" y="694" width="290" height="68" as="geometry" /></mxCell><mxCell id="edge-7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7A8A86;strokeWidth=2;" edge="1" parent="1" source="subtopic-0-1" target="video-0-1-1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="subtopic-0-2" value="&lt;b&gt;架拍与后场框架&lt;/b&gt;&lt;br&gt;109 条 · 关键词：架拍、顶肘、引拍、抬拍" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB8B4;strokeWidth=1.5;fontSize=12;align=left;spacingLeft=10;arcSize=5;" vertex="1" parent="1"><mxGeometry x="60" y="785" width="300" height="82" as="geometry" /></mxCell><mxCell id="edge-8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7A8A86;strokeWidth=2;" edge="1" parent="1" source="category-0" target="subtopic-0-2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="video-0-2-0" value="后场框架应用 如果基础好，可以推荐出快速框架，之前发过很多爆发力出框架的作品！但是顶肘动作小带来效率的同时…&lt;br&gt;&lt;font color='#52625E'&gt;curated · score 58&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9FBFA;strokeColor=#CBD6D2;strokeWidth=1;fontSize=11;align=left;spacingLeft=8;arcSize=5;" vertex="1" parent="1" link="https://www.douyin.com/video/7589749293205363633"><mxGeometry x="390" y="781" width="290" height="68" as="geometry" /></mxCell><mxCell id="edge-9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7A8A86;strokeWidth=2;" edge="1" parent="1" source="subtopic-0-2" target="video-0-2-0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="video-0-2-1" value="业余最优架拍方式！羽毛球重杀框架和快杀框架！三种后场框架优缺点和发力方式&lt;br&gt;&lt;font color='#52625E'&gt;medium · score 42&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9FBFA;strokeColor=#CBD6D2;strokeWidth=1;fontSize=11;align=left;spacingLeft=8;arcSize=5;" vertex="1" parent="1" link="https://www.bilibili.com/video/BV15pBRB6EDk/"><mxGeometry x="390" y="859" width="290" height="68" as="geometry" /></mxCell><mxCell id="edge-10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7A8A86;strokeWidth=2;" edge="1" parent="1" source="subtopic-0-2" target="video-0-2-1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="subtopic-0-3" value="&lt;b&gt;吊球与劈吊&lt;/b&gt;&lt;br&gt;47 条 · 关键词：吊球、劈吊、滑板、软压" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB8B4;strokeWidth=1.5;fontSize=12;align=left;spacingLeft=10;arcSize=5;" vertex="1" parent="1"><mxGeometry x="60" y="950" width="300" height="82" as="geometry" /></mxCell><mxCell id="edge-11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7A8A86;strokeWidth=2;" edge="1" parent="1" source="category-0" target="subtopic-0-3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="video-0-3-0" value="劈吊球 来啦！ 轻吊劈吊重劈的关键技巧！看不懂的多看几遍 别再错过十亿了&lt;br&gt;&lt;font color='#52625E'&gt;medium · score 29&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9FBFA;strokeColor=#CBD6D2;strokeWidth=1;fontSize=11;align=left;spacingLeft=8;arcSize=5;" vertex="1" parent="1" link="https://www.bilibili.com/video/BV1iF411k7R2/"><mxGeometry x="390" y="946" width="290" height="68" as="geometry" /></mxCell><mxCell id="edge-12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7A8A86;strokeWidth=2;" edge="1" parent="1" source="subtopic-0-3" target="video-0-3-0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="video-0-3-1" value="后场滑拍吊球进阶教学！爆改球友 羽毛球滑板吊球加半侧身闪动发力&lt;br&gt;&lt;font color='#52625E'&gt;medium · score 27&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9FBFA;strokeColor=#CBD6D2;strokeWidth=1;fontSize=11;align=left;spacingLeft=8;arcSize=5;" vertex="1" parent="1" link="https://www.bilibili.com/video/BV1W14qzhEtA/"><mxGeometry x="390" y="1024" width="290" height="68" as="geometry" /></mxCell><mxCell id="edge-13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7A8A86;strokeWidth=2;" edge="1" parent="1" source="subtopic-0-3" target="video-0-3-1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="subtopic-0-4" value="&lt;b&gt;正反手过渡&lt;/b&gt;&lt;br&gt;36 条 · 关键词：过渡球、过度球、过渡动作、正手过渡" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB8B4;strokeWidth=1.5;fontSize=12;align=left;spacingLeft=10;arcSize=5;" vertex="1" parent="1"><mxGeometry x="60" y="1115" width="300" height="82" as="geometry" /></mxCell><mxCell id="edge-14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7A8A86;strokeWidth=2;" edge="1" parent="1" source="category-0" target="subtopic-0-4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="video-0-4-0" value="正手被动过渡球【一】 实战过渡球这样打能直接得分 别再打又高又慢的过渡球拉&lt;br&gt;&lt;font color='#52625E'&gt;medium · score 35&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9FBFA;strokeColor=#CBD6D2;strokeWidth=1;fontSize=11;align=left;spacingLeft=8;arcSize=5;" vertex="1" parent="1" link="https://www.bilibili.com/video/BV1FB4y1Z7cD/"><mxGeometry x="390" y="1111" width="290" height="68" as="geometry" /></mxCell><mxCell id="edge-15" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7A8A86;strokeWidth=2;" edge="1" parent="1" source="subtopic-0-4" target="video-0-4-0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="video-0-4-1" value="反手过渡秘籍！成人班小姐姐从0-1学反手过渡球全程纠错&lt;br&gt;&lt;font color='#52625E'&gt;medium · score 27&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9FBFA;strokeColor=#CBD6D2;strokeWidth=1;fontSize=11;align=left;spacingLeft=8;arcSize=5;" vertex="1" parent="1" link="https://www.bilibili.com/video/BV1sKRjBREQj/"><mxGeometry x="390" y="1189" width="290" height="68" as="geometry" /></mxCell><mxCell id="edge-16" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7A8A86;strokeWidth=2;" edge="1" parent="1" source="subtopic-0-4" target="video-0-4-1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="subtopic-0-5" value="&lt;b&gt;反手后场&lt;/b&gt;&lt;br&gt;41 条 · 关键词：反手高远、反手后场、反手杀球、反拍" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB8B4;strokeWidth=1.5;fontSize=12;align=left;spacingLeft=10;arcSize=5;" vertex="1" parent="1"><mxGeometry x="60" y="1280" width="300" height="82" as="geometry" /></mxCell><mxCell id="edge-17" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7A8A86;strokeWidth=2;" edge="1" parent="1" source="category-0" target="subtopic-0-5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="video-0-5-0" value="让反手高远爆炸的秘诀！正确的反手框架加上神仙操作！学员想学反手杀！先把反手高远打透&lt;br&gt;&lt;font color='#52625E'&gt;medium · score 31&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9FBFA;strokeColor=#CBD6D2;strokeWidth=1;fontSize=11;align=left;spacingLeft=8;arcSize=5;" vertex="1" parent="1" link="https://www.bilibili.com/video/BV1ZbcUzDEd6/"><mxGeometry x="390" y="1276" width="290" height="68" as="geometry" /></mxCell><mxCell id="edge-18" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7A8A86;strokeWidth=2;" edge="1" parent="1" source="subtopic-0-5" target="video-0-5-0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="video-0-5-1" value="业余反手高远球爆改教学！反手高远击球点架拍挥拍技巧！没发错啊，前面几分钟是杀球展示&lt;br&gt;&lt;font color='#52625E'&gt;medium · score 19&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9FBFA;strokeColor=#CBD6D2;strokeWidth=1;fontSize=11;align=left;spacingLeft=8;arcSize=5;" vertex="1" parent="1" link="https://www.bilibili.com/video/BV198CdBHEPF/"><mxGeometry x="390" y="1354" width="290" height="68" as="geometry" /></mxCell><mxCell id="edge-19" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7A8A86;strokeWidth=2;" edge="1" parent="1" source="subtopic-0-5" target="video-0-5-1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="subtopic-0-6" value="&lt;b&gt;后场综合待细分&lt;/b&gt;&lt;br&gt;15 条 · 关键词：" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB8B4;strokeWidth=1.5;fontSize=12;align=left;spacingLeft=10;arcSize=5;" vertex="1" parent="1"><mxGeometry x="60" y="1445" width="300" height="82" as="geometry" /></mxCell><mxCell id="edge-20" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7A8A86;strokeWidth=2;" edge="1" parent="1" source="category-0" target="subtopic-0-6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="video-0-6-0" value="【进阶】业余跳杀爆改双脚跳杀细节教学！进阶必看！又是醍醐灌顶的一期&lt;br&gt;&lt;font color='#52625E'&gt;medium · score 0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9FBFA;strokeColor=#CBD6D2;strokeWidth=1;fontSize=11;align=left;spacingLeft=8;arcSize=5;" vertex="1" parent="1" link="https://www.bilibili.com/video/BV1QY6qBdEBt/"><mxGeometry x="390" y="1441" width="290" height="68" as="geometry" /></mxCell><mxCell id="edge-21" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7A8A86;strokeWidth=2;" edge="1" parent="1" source="subtopic-0-6" target="video-0-6-0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="video-0-6-1" value="专业队羽毛球双脚跳杀示范！230斤跳杀欢乐花絮&lt;br&gt;&lt;font color='#52625E'&gt;medium · score 0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9FBFA;strokeColor=#CBD6D2;strokeWidth=1;fontSize=11;align=left;spacingLeft=8;arcSize=5;" vertex="1" parent="1" link="https://www.bilibili.com/video/BV1tki1YBEuL/"><mxGeometry x="390" y="1519" width="290" height="68" as="geometry" /></mxCell><mxCell id="edge-22" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7A8A86;strokeWidth=2;" edge="1" parent="1" source="subtopic-0-6" target="video-0-6-1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="category-1" value="&lt;b&gt;网前技术&lt;/b&gt;&lt;br&gt;95 条 · 搓、勾、推、扑、挑、放网及网前持拍框架。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7E6DE;strokeColor=#B85C38;strokeWidth=2;fontSize=15;fontStyle=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="830" y="320" width="620" height="86" as="geometry" /></mxCell><mxCell id="edge-23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7A8A86;strokeWidth=2;" edge="1" parent="1" source="skill" target="category-1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="subtopic-1-0" value="&lt;b&gt;搓球与滚网&lt;/b&gt;&lt;br&gt;16 条 · 关键词：搓球、滚网、平搓" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB8B4;strokeWidth=1.5;fontSize=12;align=left;spacingLeft=10;arcSize=5;" vertex="1" parent="1"><mxGeometry x="830" y="455" width="300" height="82" as="geometry" /></mxCell><mxCell id="edge-24" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7A8A86;strokeWidth=2;" edge="1" parent="1" source="category-1" target="subtopic-1-0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="video-1-0-0" value="滚网搓球 双打网前有人看守时有奇效&lt;br&gt;&lt;font color='#52625E'&gt;medium · score 23&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9FBFA;strokeColor=#CBD6D2;strokeWidth=1;fontSize=11;align=left;spacingLeft=8;arcSize=5;" vertex="1" parent="1" link="https://www.douyin.com/video/7509355373729762619"><mxGeometry x="1160" y="451" width="290" height="68" as="geometry" /></mxCell><mxCell id="edge-25" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7A8A86;strokeWidth=2;" edge="1" parent="1" source="subtopic-1-0" target="video-1-0-0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="video-1-0-1" value="平搓远网 平搓可以根据情况加力减力，手臂也可以适当的介入辅助&lt;br&gt;&lt;font color='#52625E'&gt;medium · score 22&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9FBFA;strokeColor=#CBD6D2;strokeWidth=1;fontSize=11;align=left;spacingLeft=8;arcSize=5;" vertex="1" parent="1" link="https://www.douyin.com/video/7411850466457292084"><mxGeometry x="1160" y="529" width="290" height="68" as="geometry" /></mxCell><mxCell id="edge-26" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7A8A86;strokeWidth=2;" edge="1" parent="1" source="subtopic-1-0" target="video-1-0-1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="subtopic-1-1" value="&lt;b&gt;勾球与变线&lt;/b&gt;&lt;br&gt;19 条 · 关键词：勾球、勾对角、网前变线" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB8B4;strokeWidth=1.5;fontSize=12;align=left;spacingLeft=10;arcSize=5;" vertex="1" parent="1"><mxGeometry x="830" y="620" width="300" height="82" as="geometry" /></mxCell><mxCell id="edge-27" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7A8A86;strokeWidth=2;" edge="1" parent="1" source="category-1" target="subtopic-1-1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="video-1-1-0" value="身前位勾球，和侧身位的勾球不一样，正手也存在变拍，只不过没反手那么需要&lt;br&gt;&lt;font color='#52625E'&gt;medium · score 24&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9FBFA;strokeColor=#CBD6D2;strokeWidth=1;fontSize=11;align=left;spacingLeft=8;arcSize=5;" vertex="1" parent="1" link="https://www.douyin.com/video/7064010057020673314"><mxGeometry x="1160" y="616" width="290" height="68" as="geometry" /></mxCell><mxCell id="edge-28" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7A8A86;strokeWidth=2;" edge="1" parent="1" source="subtopic-1-1" target="video-1-1-0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="video-1-1-1" value="不是说勾球不能带过去，是不能大臂和球拍一起过去，如果学不会，就先练简单的勾球，这属于进阶&lt;br&gt;&lt;font color='#52625E'&gt;medium · score 23&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9FBFA;strokeColor=#CBD6D2;strokeWidth=1;fontSize=11;align=left;spacingLeft=8;arcSize=5;" vertex="1" parent="1" link="https://www.douyin.com/video/7231373527314631947"><mxGeometry x="1160" y="694" width="290" height="68" as="geometry" /></mxCell><mxCell id="edge-29" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7A8A86;strokeWidth=2;" edge="1" parent="1" source="subtopic-1-1" target="video-1-1-1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="subtopic-1-2" value="&lt;b&gt;扑球与推球&lt;/b&gt;&lt;br&gt;28 条 · 关键词：扑球、推球、抢网" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB8B4;strokeWidth=1.5;fontSize=12;align=left;spacingLeft=10;arcSize=5;" vertex="1" parent="1"><mxGeometry x="830" y="785" width="300" height="82" as="geometry" /></mxCell><mxCell id="edge-30" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7A8A86;strokeWidth=2;" edge="1" parent="1" source="category-1" target="subtopic-1-2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="video-1-2-0" value="为什么正手推球发不上力？ 无敌透彻的推球发力技巧！ 你要不要吧&lt;br&gt;&lt;font color='#52625E'&gt;medium · score 22&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9FBFA;strokeColor=#CBD6D2;strokeWidth=1;fontSize=11;align=left;spacingLeft=8;arcSize=5;" vertex="1" parent="1" link="https://www.bilibili.com/video/BV1uD421E7Uk/"><mxGeometry x="1160" y="781" width="290" height="68" as="geometry" /></mxCell><mxCell id="edge-31" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7A8A86;strokeWidth=2;" edge="1" parent="1" source="subtopic-1-2" target="video-1-2-0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="video-1-2-1" value="小羊联动 被正手扑球如何解？羽毛球单打高端局 解九死一生的扑球方法揭秘&lt;br&gt;&lt;font color='#52625E'&gt;medium · score 18&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9FBFA;strokeColor=#CBD6D2;strokeWidth=1;fontSize=11;align=left;spacingLeft=8;arcSize=5;" vertex="1" parent="1" link="https://www.bilibili.com/video/BV1XFXaYmEhK/"><mxGeometry x="1160" y="859" width="290" height="68" as="geometry" /></mxCell><mxCell id="edge-32" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7A8A86;strokeWidth=2;" edge="1" parent="1" source="subtopic-1-2" target="video-1-2-1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="subtopic-1-3" value="&lt;b&gt;放网与挡网&lt;/b&gt;&lt;br&gt;9 条 · 关键词：放网、挡网、网前球" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB8B4;strokeWidth=1.5;fontSize=12;align=left;spacingLeft=10;arcSize=5;" vertex="1" parent="1"><mxGeometry x="830" y="950" width="300" height="82" as="geometry" /></mxCell><mxCell id="edge-33" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7A8A86;strokeWid